# Use a fresh token of at least 24 characters; never commit real credentials.
JARVIS_OPERATOR_TOKEN=
JARVIS_BIND=127.0.0.1
JARVIS_PORT=8765
JARVIS_DB=jarvis.sqlite3
# Optional integrations: disabled unless configured by the operator.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=
BROWSER_USE_API_KEY=

# Optional n8n-to-Core proof workflow. Use a dedicated random token, never the operator token.
# The endpoint is off unless BOTH token (>=32 chars) and workflow IDs are configured.
JARVIS_N8N_INGEST_TOKEN=
JARVIS_N8N_WORKFLOW_IDS=
